        { "label": "Proceed to Checkout", "action": "click", "selector": "button.buy-now" }
      ],
      "predicates": {
        "scarcity_urgency": {
          "positive_predicates": [
            "countdown_timer_present",
            "urgency_text_present",
            "scarcity_claim_present"
          ],
          "negative_predicates": [
            "no_timer_in_clean",
            "no_pressure_in_clean"
          ]
        }
      },
      "evidence_summary": "Live countdown timer present in DARK variant ('HURRY! Flash Sale ends in...') and absent in CLEAN variant."
    },
